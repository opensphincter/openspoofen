[Unit]
Description=OpenSpoofen local admin UI
After=network-online.target openspoofen-nordvpn-bootstrap.service
Wants=network-online.target openspoofen-nordvpn-bootstrap.service

[Service]
Type=simple
WorkingDirectory=/opt/openspoofen
EnvironmentFile=-/etc/openspoofen/openspoofen.env
EnvironmentFile=-/etc/openspoofen/secrets/nordvpn.local.env
ExecStart=/opt/openspoofen/.venv/bin/python -m openspoofen.serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/openspoofen /etc/openspoofen

[Install]
WantedBy=multi-user.target