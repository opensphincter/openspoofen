RP_DEVICE_HOSTNAME=openspoofen
RP_PROVIDER=nordvpn
RP_HOST=0.0.0.0
RP_PORT=8080
RP_SECRET_KEY=change-me
RP_PREFERRED_TOPOLOGY=wifi-wan_eth-lan
RP_FAIL_CLOSED=true
RP_LAN_ONLY=true
RP_ENABLE_HTTPS=false
RP_REQUIRE_PAIRING_TOKEN=false
RP_SESSION_PERSIST_DAYS=30
RP_RUNTIME_DIR=/var/lib/openspoofen
RP_AUTH_STATE_PATH=/var/lib/openspoofen/lan-auth.json
RP_STATE_PATH=/var/lib/openspoofen/mock-state.json
RP_TV_REMOTE_STATE_PATH=/var/lib/openspoofen/tv-remote.json
RP_TV_REMOTE_VENDOR=samsung
RP_TV_REMOTE_NAME=OpenSpoofen Remote
RP_WIREGUARD_CONFIG_DIR=configs/wireguard
RP_SURFSHARK_CONFIG_DIR=configs/surfshark
RP_DOWNSTREAM_INTERFACE=eth0
RP_UPSTREAM_INTERFACE=wlan0
RP_COMMAND_TIMEOUT_SECONDS=15
RP_NETWORK_PROBE_CACHE_TTL_SECONDS=2
RP_LOCATION_CACHE_TTL_SECONDS=30
RP_PROVIDER_HOME=
RP_PROVIDER_USER=
RP_NORDVPN_SECRET_PATH=/etc/openspoofen/secrets/nordvpn.local.env
RP_NORDVPN_BOOTSTRAP_ENABLED=true
RP_NORDVPN_AUTOCONNECT=true
RP_NORDVPN_LAN_DISCOVERY=true
# In TV Ethernet router mode the bootstrap disables NordVPN's own firewall and kill switch,
# because appliance-managed nftables owns forwarded fail-closed behavior for downstream clients.
RP_NORDVPN_FIREWALL=true
RP_NORDVPN_KILLSWITCH=true
RP_NORDVPN_ALLOWLIST_SUBNET=192.168.50.0/24
# Dev-only option: auto-login the Pi console on tty1 after boot so local iteration does not stop at the Linux login prompt.
RP_DEV_CONSOLE_AUTOLOGIN=false
RP_DEV_CONSOLE_AUTOLOGIN_USER=
# If HTTPS is enabled and these paths are left blank, install.sh generates a self-signed cert for openspoofen.local.
# Browsers on iPhone/iPad will still treat that cert as untrusted until you explicitly trust it.
RP_TLS_CERT_PATH=
RP_TLS_KEY_PATH=