# OpenSpoofen TCP tuning for streaming throughput
# Installed by bootstrap/install.sh to /etc/sysctl.d/

# Increase socket buffer sizes for smoother file serving over Wi-Fi
net.core.rmem_max=1048576
net.core.wmem_max=1048576
net.ipv4.tcp_rmem=4096 131072 1048576
net.ipv4.tcp_wmem=4096 65536 1048576

# BBR congestion control provides better throughput on Wi-Fi links
# Falls back gracefully if kernel doesn't support it
net.ipv4.tcp_congestion_control=bbr
net.core.default_qdisc=fq

# Increase connection tracking for VPN traffic
net.netfilter.nf_conntrack_max=131072
