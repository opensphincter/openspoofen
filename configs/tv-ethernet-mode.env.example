RP_TV_ETHERNET_MODE=true
RP_TV_LAN_IFACE=eth0
# Set this to wlan0 for Wi-Fi uplink, or to eth1/enx... for a USB Ethernet uplink.
# The Windows deploy helper can install this file during first deployment with
# -LocalTvModeEnvFile .\configs\tv-ethernet-mode.env.example or a local copy.
RP_TV_UPLINK_IFACE=wlan0
RP_TV_VPN_IFACE=nordlynx
RP_TV_LAN_ADDRESS=192.168.50.1/24
# Keep downstream traffic fail-closed to the VPN path by default.
# Set this to true only if you explicitly want the TV to bypass the VPN over the uplink.
RP_TV_ALLOW_UPLINK_FALLBACK=false
# Default to a NordLynx-safe MTU so consumer TVs do not rely on fragile PMTU discovery.
RP_TV_LAN_MTU=1420
RP_TV_DHCP_START=192.168.50.50
RP_TV_DHCP_END=192.168.50.150
RP_TV_DHCP_LEASE=12h
RP_TV_CONNECTION_NAME=openspoofen-tv-lan